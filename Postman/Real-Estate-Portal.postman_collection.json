            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Property Management",
      "item": [
        {
          "name": "2.1 Create Property Listing (Agent Only - Sets {{propertyId}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.property) {",
                  "    pm.collectionVariables.set(\"propertyId\", jsonData.data.property._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Panoramic Sky Villa in Koramangala\",\n  \"description\": \"Lavish penthouse featuring private terrace deck, plunge pool, Italian marble flooring, and smart home automation.\",\n  \"type\": \"Villa\",\n  \"listingType\": \"SALE\",\n  \"price\": 29500000,\n  \"city\": \"Bengaluru\",\n  \"locality\": \"Koramangala\",\n  \"bedrooms\": 4,\n  \"bathrooms\": 4,\n  \"area\": 3600,\n  \"images\": [\n    \"https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties",
              "host": ["{{baseUrl}}"],
              "path": ["properties"]
            }
          }
        },
        {
          "name": "2.2 Get Verified Properties (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties",
              "host": ["{{baseUrl}}"],
              "path": ["properties"]
            }
          }
        },
        {
          "name": "2.3 Get Agent My Listings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/my",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "my"]
            }
          }
        },
        {
          "name": "2.4 Get Property By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{propertyId}}"]
            }
          }
        },
        {
          "name": "2.5 Update Property (Owner Agent Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 28900000,\n  \"description\": \"Updated price discount for festive season. Lavish penthouse in Koramangala.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{propertyId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Search, Filter & Location Grouping",
      "item": [
        {
          "name": "3.1 Search & Filter Properties (City, Type, Price)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties/search?city=Bengaluru&type=Villa&maxPrice=50000000&bedrooms=3&sortBy=price_asc",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "search"],
              "query": [
                { "key": "city", "value": "Bengaluru" },
                { "key": "type", "value": "Villa" },
                { "key": "maxPrice", "value": "50000000" },
                { "key": "bedrooms", "value": "3" },
                { "key": "sortBy", "value": "price_asc" }
              ]
            }
          }
        },
        {
          "name": "3.2 Group Listings By Cities (GET /properties/cities)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties/cities",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "cities"]
            }
          }
        },
        {
          "name": "3.3 Browse City Properties (GET /properties/city/:city)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties/city/Bengaluru",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "city", "Bengaluru"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Property Verification Workflow (Admin)",
      "item": [
        {
          "name": "4.1 Get Pending Listings Awaiting Review",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/properties/pending",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "properties", "pending"]
            }
          }
        },
        {
          "name": "4.2 Verify Property (Admin Only: PENDING -> VERIFIED)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VERIFIED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{propertyId}}", "verify"]
            }
          }
        },
        {
          "name": "4.3 Reject Property with Reason (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"rejectionReason\": \"Incomplete RERA sanction and title deed documentation.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{propertyId}}", "verify"]
            }
          }
        }
      ]
    },
