    {
      "name": "10. Required Error & Business Rule Edge Cases",
      "item": [
        {
          "name": "10.1 Validation Failure -> 400 (Bad Email Format)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "10.2 Missing Token -> 401 Unauthorized",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "10.3 Wrong Role -> 403 Forbidden (Buyer accessing Admin API)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "10.4 Invalid / Non-existent ID -> 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties/507f1f77bcf86cd799439011",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "507f1f77bcf86cd799439011"]
            }
          }
        },
        {
          "name": "10.5 Duplicate Favourite -> 409 Conflict",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/favourites/{{propertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["favourites", "{{propertyId}}"]
            }
          }
        },
        {
          "name": "10.6 Invalid Enquiry Status Transition -> 409 Conflict",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"NEW\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enquiries/{{enquiryId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries", "{{enquiryId}}", "status"]
            }
          }
        },
        {
          "name": "10.7 Invalid Property Status Transition -> 409 Conflict (SOLD -> AVAILABLE)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{propertyId}}", "status"]
            }
          }
        },
        {
          "name": "10.8 Registration Self-Assign Admin -> 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fake Admin\",\n  \"email\": \"fake.admin@domain.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    }
  ]
}
